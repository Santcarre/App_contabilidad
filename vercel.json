{
  "crons": [
    {
      "path": "/api/cron/exchange-rates",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/recurrentes",
      "schedule": "0 9 1 * *"
    }
  ],
  "headers": [
    {
      "source": "/api/cron/(.*)",
      "headers": [
        { "key": "Authorization", "value": "Bearer ${CRON_SECRET}" }
      ]
    }
  ]
}